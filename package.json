{
  "name": "idedb",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "IDEDB_PG_URL=postgres://idedb:idedb@localhost:54329/idedb IDEDB_MYSQL_URL=mysql://idedb:idedb@localhost:33069/idedb cargo test --workspace",
    "icon": "node scripts/render-icon.mjs && tauri icon design/icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/64x64.png"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@lezer/highlight": "^1.2.4",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "cmdk": "^1.1.1",
    "dockview-react": "^8.3.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.48.0",
    "marked": "^16.4.2",
    "react": "^19.1.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.13.3",
    "react-responsive-carousel": "^3.2.23",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "tinykeys": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
